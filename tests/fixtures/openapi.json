  "info": {
    "summary": "Stats of quadkey cells by prefix, bbox or polygon.",
    "title": "gridtiles"
  },
  "openapi": "3.1.0",
  "paths": {
    "/layers": {
      "get": {
        "description": "Every layer's manifest.",
        "operationId": "list_layers_layers_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "title": "Response List Layers Layers Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Layers"
      }
    },
    "/layers/{name}": {
      "get": {
        "description": "A layer's manifest: spec, stats, bounds and snapshots.",
        "operationId": "get_layer_layers__name__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Layer Layers  Name  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Layer"
      }
    },
    "/layers/{name}/cells/{qk}": {
      "get": {
        "description": "One cell, its values as the tile properties.",
        "operationId": "get_cell_layers__name__cells__qk__get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Quadkey text; its length is the zoom",
            "in": "path",
            "name": "qk",
            "required": true,
            "schema": {
              "description": "Quadkey text; its length is the zoom",
              "pattern": "^[0-3]{0,30}$",
              "title": "Qk",
              "type": "string"
            }
          },
          {
            "description": "Snapshot [default: the latest] on snapshot layers",
            "in": "query",
            "name": "snapshot",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Snapshot [default: the latest] on snapshot layers",
              "title": "Snapshot"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cell"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Cell"
      }
    },
    "/layers/{name}/stats": {
      "get": {
        "description": "Stats of the cells in a quadkey prefix, or whose centroid lies in a bbox.",
        "operationId": "get_stats_layers__name__stats_get",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Quadkey prefix",
            "in": "query",
            "name": "prefix",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "pattern": "^[0-3]{0,30}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Quadkey prefix",
              "title": "Prefix"
            }
          },
          {
            "description": "west,south,east,north in WGS84",
            "in": "query",
            "name": "bbox",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "west,south,east,north in WGS84",
              "title": "Bbox"
            }
          },
          {
            "description": "Zoom of the cells to sum [default: the base zoom]",
            "in": "query",
            "name": "zoom",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Zoom of the cells to sum [default: the base zoom]",
              "title": "Zoom"
            }
          },
          {
            "description": "Snapshot [default: the latest] on snapshot layers",
            "in": "query",
            "name": "snapshot",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Snapshot [default: the latest] on snapshot layers",
              "title": "Snapshot"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Stats"
      },
      "post": {
        "description": "Stats of the cells whose centroid lies in a GeoJSON polygon.",
        "operationId": "post_stats_layers__name__stats_post",
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "title": "Name",
              "type": "string"
            }
          },
          {
            "description": "Zoom of the cells to sum [default: the base zoom]",
            "in": "query",
            "name": "zoom",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Zoom of the cells to sum [default: the base zoom]",
              "title": "Zoom"
            }
          },
          {
            "description": "Snapshot [default: the latest] on snapshot layers",
            "in": "query",
            "name": "snapshot",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Snapshot [default: the latest] on snapshot layers",
              "title": "Snapshot"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Polygon"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Stats"
      }
    }
  }
}
